# エディタの既定。改行コードはファイルごとに元の形式を保つので end_of_line は決めない
# (.gitattributes と file-format.yml を参照)。charset は .github/scripts/bom_policy.py と揃える。
root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

# PowerShell スクリプトも BOM を付けない。ASCII だけで書くので、BOM が無くても
# Windows PowerShell 5.1 がどのコードページで読んでも同じになる (.github/scripts/bom_policy.py)。
